                <p>Сб-Вс: с 9:00 до 23:00</p>
            </div>
            <div class="footer-col">
                <h3><i class="fa-solid fa-phone"></i> Связаться</h3>
                <a href="tel:+79990000000" class="btn">Позвонить</a>
            </div>
        </div>
        <div class="copyright">
            <p>© 2026 Roast & Co. Сайт-демо для портфолио.</p>
        </div>
    </footer>

    <div id="lightbox" class="lightbox">
        <span class="close-btn">&times;</span>
        <img class="lightbox-content" id="lightbox-img" alt="Увеличенное фото">
    </div>

    <script src="script.js"></script>
</body>
</html>


document.addEventListener("DOMContentLoaded", () => {
    // --- 1. Горизонтальная прокрутка меню колесиком мыши ---
    const menuCarousel = document.getElementById("menuCarousel");
    if (menuCarousel) {
        menuCarousel.addEventListener("wheel", (evt) => {
            evt.preventDefault(); 
            menuCarousel.scrollLeft += evt.deltaY; 
        });
    }

    // --- 2. Логика для модального окна (Lightbox) ---
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img");
    const closeBtn = document.querySelector(".close-btn");
    const images = document.querySelectorAll(".lightbox-trigger");

    images.forEach(img => {
        img.addEventListener("click", () => {
            lightbox.style.display = "flex";
            lightboxImg.src = img.src; 
        });
    });

    closeBtn.addEventListener("click", () => {
        lightbox.style.display = "none";
    });

    lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) {
            lightbox.style.display = "none";
        }
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lightbox.style.display === "flex") {
            lightbox.style.display = "none";
        }
    });
});
/* Базовые настройки и насыщенная палитра */
:root {
    --bg-color: #fcf7f0;
    --text-main: #2b2b2b;
    --text-light: #5a5a5a;
    --accent: #78b8a3;
    --accent-dark: #579880;
    --secondary: #f0cdb9;
    --white: #ffffff;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Montserrat', sans-serif;
    color: var(--text-main);
    line-height: 1.6;
    background-color: var(--bg-color);
    background-image: linear-gradient(135deg, #fcf7f0 0%, #f5e6d8 100%);
    background-attachment: fixed;
}

.container { max-width: 960px; margin: 0 auto; padding: 0 20px; }

/* Шапка */
.header {
    background: rgba(252, 247, 240, 0.9);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    border-bottom: 1px solid rgba(120, 184, 163, 0.2);
}
.header-container { display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; }
.logo { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
.logo i { color: var(--accent-dark); }
.nav a { text-decoration: none; color: var(--text-main); margin-left: 25px; font-weight: 600; font-size: 14px; transition: color 0.3s; }
.nav a:hover { color: var(--accent-dark); }

/* Главный экран */
.hero {
    height: 60vh; min-height: 400px; position: relative; display: flex; align-items: center; text-align: center; color: var(--white);
    background: url('https://images.unsplash.com/photo-1497935586351-b67a49e012bf?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
}
img { filter: sepia(20%) contrast(105%) saturate(110%); }
.hero-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(to bottom, rgba(43, 43, 43, 0.3), rgba(43, 43, 43, 0.6)); z-index: 1; }
.hero-content { position: relative; z-index: 2; width: 100%; }
.hero h1 { font-family: 'Playfair Display', serif; font-size: 46px; margin-bottom: 15px; text-shadow: 2px 2px 8px rgba(0,0,0,0.4); }
.hero p { font-size: 18px; margin-bottom: 30px; text-shadow: 1px 1px 4px rgba(0,0,0,0.4); }

/* Кнопки */
.btn {
    display: inline-flex; align-items: center; gap: 8px; background-color: var(--accent); color: var(--white);
    padding: 12px 28px; text-decoration: none; border-radius: 30px; font-weight: 600; font-size: 15px;
    transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(120, 184, 163, 0.3); border: none; cursor: pointer;
}
.btn:hover { background-color: var(--accent-dark); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(87, 152, 128, 0.4); }

/* Секции */
.section-title { font-family: 'Playfair Display', serif; font-size: 32px; text-align: center; margin-bottom: 15px; color: var(--text-main); }

/* Меню */
.menu-section { padding: 60px 0; }
.scroll-hint { text-align: center; color: var(--accent-dark); font-size: 13px; margin-bottom: 25px; opacity: 0.9; }
.menu-carousel {
    display: flex; gap: 20px; overflow-x: auto; padding-bottom: 30px;
    scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: var(--accent) transparent;
}
.menu-carousel::-webkit-scrollbar { height: 6px; }
.menu-carousel::-webkit-scrollbar-track { background: rgba(240, 205, 185, 0.5); border-radius: 10px; }
.menu-carousel::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 10px; }

.menu-card {
    flex: 0 0 280px; background: var(--white); border-radius: 16px; overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06); transition: transform 0.3s, box-shadow 0.3s;
    scroll-snap-align: start; border: 1px solid rgba(240, 205, 185, 0.3);
}
.menu-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(120, 184, 163, 0.25); }
.menu-card img { width: 100%; height: 180px; object-fit: cover; }
.card-content { padding: 25px 20px; }
.card-content h3 { margin-bottom: 8px; font-size: 18px; color: var(--text-main); }
.card-content p { color: var(--text-light); font-size: 13px; margin-bottom: 15px; min-height: 38px; }
.price { font-weight: 700; font-size: 18px; color: var(--accent-dark); display: block; text-align: right; }

/* О нас */
.about-section { padding: 60px 0; background: var(--secondary); }
.about-content { display: flex; align-items: center; gap: 40px; }
.about-text { flex: 1; }
.about-text p { color: var(--text-main); margin-bottom: 25px; font-size: 16px; }
.features-list { list-style: none; }
.features-list li { margin-bottom: 12px; font-weight: 600; font-size: 15px; display: flex; align-items: center; gap: 12px; color: var(--text-main); }
.features-list i { color: var(--accent-dark); font-size: 20px; background: var(--white); padding: 10px; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 50%; box-shadow: 0 4px 10px rgba(0,0,0,0.08); }

/* Коллаж */
.about-collage { flex: 1; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 15px; }
.collage-img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,0.1); cursor: pointer; transition: transform 0.3s, box-shadow 0.3s; }
.collage-img:hover { transform: scale(1.05); box-shadow: 0 12px 25px rgba(0,0,0,0.2); z-index: 2; position: relative; }

/* Лайтбокс */
.lightbox {
    display: none; position: fixed; z-index: 999; left: 0; top: 0; width: 100%; height: 100%;
    background-color: rgba(43, 43, 43, 0.9); backdrop-filter: blur(5px); align-items: center; justify-content: center;
}
.lightbox-content { max-width: 90%; max-height: 85%; border-radius: 12px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); animation: zoomIn 0.3s ease; filter: none; }
@keyframes zoomIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.close-btn { position: absolute; top: 20px; right: 40px; color: var(--white); font-size: 50px; font-weight: 300; cursor: pointer; transition: color 0.3s; line-height: 1; }
.close-btn:hover { color: var(--accent); }

/* Блок Отзывов (Сетка) */
.reviews-section { padding: 60px 0; background-color: var(--bg-color); }
.reviews-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px; margin-top: 40px; }
.review-card { background: var(--white); border-radius: 16px; padding: 25px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05); border: 1px solid rgba(240, 205, 185, 0.3); transition: transform 0.3s; display: flex; flex-direction: column; }
.review-card:hover { transform: translateY(-5px); }
.review-header { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; }
.avatar { width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; flex-shrink: 0; }
.review-meta h4 { font-size: 16px; color: var(--text-main); margin-bottom: 3px; }
.stars { color: #f5b041; font-size: 12px; }
.review-text { font-size: 14px; color: var(--text-light); line-height: 1.6; font-style: italic; }

/* Подвал */
.footer { background: #dfd4c5; color: var(--text-main); padding: 50px 0 20px; border-top: 1px solid rgba(0,0,0,0.08); }
.footer-content { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 30px; margin-bottom: 40px; }
.footer-col h3 { margin-bottom: 15px; color: var(--text-main); display: flex; align-items: center; gap: 8px; font-size: 16px; }
.footer-col h3 i { color: var(--accent-dark); }
.footer-col p { color: var(--text-light); margin-bottom: 8px; font-size: 14px; }
.copyright { text-align: center; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 20px; font-size: 12px; color: var(--text-light); }

/* Адаптив */
@media (max-width: 768px) {
    .hero h1 { font-size: 32px; }
    .hero p { font-size: 16px; }
    .about-content { flex-direction: column; }
    .about-collage { width: 100%; }
    .footer-content { flex-direction: column; text-align: center; }
    .footer-col h3 { justify-content: center; }
    .nav { display: none; }
}
